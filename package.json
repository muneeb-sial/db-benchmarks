{
  "name": "db-benchmarks",
  "type": "module",
  "scripts": {
    "server": "bun src/index.ts",
    "seed": "bun src/seed/generate.ts",
    "bench": "bun src/suite/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p src/ui",
    "build": "bun run typecheck && bun src/build.ts",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "cassandra-driver": "^4.9.0",
    "mongodb": "^6.21.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.2",
    "typescript": "~5.9.3",
    "@types/bun": "latest"
  },
  "overrides": {
    "adm-zip": "^0.6.1"
  },
  "private": true
}
